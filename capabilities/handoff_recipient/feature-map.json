      "command": "python3 capabilities/handoff_recipient/check.py --self Apo·内容 --aliases capabilities/handoff_recipient/fixtures/aliases.json capabilities/handoff_recipient/fixtures/r2-card-a.txt",
      "expected": "exit 4 MISADDRESSED",
