    {
      "id": "real-green-sample",
      "command": "python3 capabilities/handoff_recipient/check.py --self 市场情报 --aliases capabilities/handoff_recipient/fixtures/aliases.json capabilities/handoff_recipient/fixtures/r2-card-a.txt",
      "expected": "exit 0 ACCEPT",
      "tests": [
        "test_same_card_is_green_for_its_real_recipient",
        "test_multiline_r1_handoff"
      ]
    },
    {
      "id": "fail-closed-rules",
      "command": "python3 -m unittest discover -s capabilities/handoff_recipient/tests -v",
