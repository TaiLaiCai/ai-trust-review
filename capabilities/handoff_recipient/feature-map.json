      "tests": [
        "Rules",
        "AmbiguityV11"
      ]
    },
    {
      "id": "cli-contract",
      "command": "python3 -m unittest discover -s capabilities/handoff_recipient/tests -v",
      "expected": "exit codes 0/3/4/5/2, JSON output, oversize and non-UTF-8 rejected, content inert",
      "tests": [
        "Cli"
      ]
    },
    {
      "id": "invisible-mn-v13",
      "command": "python3 capabilities/handoff_recipient/check.py --self 内容 --aliases capabilities/handoff_recipient/fixtures/aliases.json -",
      "expected": "T+U+034F+o or T+U+FE0F+o as a second To exits 3 AMBIGUOUS; a normal card still exits 0; visible Mn inside a label exits 3; Mn in prose does not by itself reject",
      "tests": [
        "MarksV13",
        "test_mn_hidden_second_to_has_nonzero_cli_exit"
      ]
    },
    {
      "id": "ambiguity-v11",
      "command": "python3 -m unittest discover -s capabilities/handoff_recipient/tests -v",
      "expected": "empty or multiline To, mixed-case different recipient, duplicate JSON key never ACCEPT",
      "tests": [
        "AmbiguityV11",
        "test_v11_probes_have_nonzero_cli_exits"
