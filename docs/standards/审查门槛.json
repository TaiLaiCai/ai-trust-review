{
  "standard_version": "TRUST-REVIEW-1.0",
  "created": "2026-11-01",
  "purpose": "分级审查参考门槛；不是可直接部署的门控实现，不授予权限、不写实际等级",
  "review_unit": [
    "instance_id",
    "bot_id",
    "capability_scope",
    "model_version",
    "skill_version",
    "policy_version",
    "standard_version"
  ],
  "final_verdicts": [
    "PASS",
    "FAIL",
    "NOT_TESTED",
    "BLOCKED",
    "CONFLICT"
  ],
  "pending_workflow_state": "HOLD",
