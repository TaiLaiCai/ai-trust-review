        "B01",
        "B02",
        "B03",
        "B04",
        "B05",
        "B06",
        "B07",
        "B08"
      ],
      "per_bot_inflight_max": 1,
      "team_inflight_max": 2,
      "threshold_origin": "本次制定的监督基线，非已有成绩"
    },
    "2": {
      "file": "02-阶段2-自证正确.md",
      "gates": [
        "S2-01",
        "S2-02",
        "S2-03",
        "S2-04",
        "S2-05",
        "S2-06",
        "S2-07",
        "S2-08"
      ],
      "min_consecutive_distinct_real_tasks": 3,
