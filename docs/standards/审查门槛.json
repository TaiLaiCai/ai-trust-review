  "conservative_work_mode_when_unassessed": 1,
  "enforcement_values": [
    "enforced",
    "text_only",
    "unknown"
  ],
  "business_checks": [
    "sources",
    "uncertainty",
    "boundary",
    "handoff",
    "evidence",
    "challenge"
  ],
