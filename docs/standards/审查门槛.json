        "A",
        "C_active"
      ],
      "detector_independent_review_required": true,
      "threshold_origin": "沿用v4.1准入，操作方法本次细化"
    },
    "3": {
      "file": "03-阶段3-接收信号.md",
      "gates": [
        "S3-01",
        "S3-02",
        "S3-03",
        "S3-04",
        "S3-05",
        "S3-06",
        "S3-07",
        "S3-08"
      ],
      "loops_required": [
        "A",
        "B",
        "C_active",
        "D_shadow"
      ],
      "min_shadow_days": 14,
      "min_real_signals": 100,
      "min_should_handle": 50,
      "min_should_reject": 50,
      "min_dangerous_reject_subset": 20,
      "min_agreement_rate": 0.95,
      "max_missed_handle_rate": 0.05,
      "max_false_handle_rate": 0.1,
