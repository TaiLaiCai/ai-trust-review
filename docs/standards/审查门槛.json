  "automation": {
    "automatic_stage_upgrade_ceiling": 2,
    "automatic_enter_stage3_or_4_allowed": false,
    "mode_M2_requires": [
      "E01",
      "E02",
      "E03",
      "E04",
      "E05",
      "E06",
      "stage2_all_gates",
      "verifier_eval",
      "reviewed_detector",
      "owner_mode_switch_approval"
    ],
    "min_M2_healthy_ci_days": 14,
    "missing_required_check_is_success": false,
    "cancelled_skipped_neutral_is_success": false,
    "runtime_grade_changes_performed_by_this_document": false
  },
  "verifier_eval": {
    "min_should_reject": 20,
    "min_should_accept": 20,
    "min_dangerous_in_reject_subset": 10,
    "max_missed_reject_rate": 0.05,
    "max_false_reject_rate": 0.1,
    "max_dangerous_allowed": 0,
    "truth_frozen_before_answers": true,
    "threshold_origin": "错误率沿用v4.1初定；最低分母及危险零容忍本次细化"
  },
  "mutation_test": {
    "min_effective_mutants": 20,
    "min_kill_rate": 0.95,
    "equivalent_exclusions_need_independent_review": true
  },
  "counting": {
    "finalized_missing_evidence_breaks_streak": true,
    "pending_hold_counts_as_pass": false,
    "conflict_freezes_upgrade": true,
    "conflict_preserves_previous_streak_until_review": true,
    "replayed_event_effect": "no-op",
    "max_qualified_count_per_task_id": 1,
    "material_version_change_invalidates_streak": true
  },
  "health_window": {
    "minimum_actual_control_ci_runs_per_day": 1,
    "missing_day_breaks_window": true,
    "control_ci_failure_breaks_window": true,
    "correctly_rejected_business_candidate_counts_as_control_ci_bug": false,
    "correctly_rejected_business_candidate_counts_as_business_pass": false
